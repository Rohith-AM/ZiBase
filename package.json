{
  "name": "zibase",
  "version": "1.2.2",
  "description": "Markdown tables as living databases.",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
