    "test": "tsx --test src/formula.test.ts src/schema.test.ts"
  },
  "keywords": ["obsidian", "obsidian-plugin", "markdown", "database", "table", "kanban"],
  "author": "Rohith A (ZIYAL)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
